[MappingDeclaration] @collection [[
mappingId	agent
target		:agent/{agent_pk} a dcterms:Agent ; dcterms:title {preferred_agent_name}^^xsd:string ; dwc:agentID {agent_id}^^xsd:string , {agent_pk}^^xsd:string ; dwc:agentRemarks {agent_remarks}^^xsd:string ; dwc:agentType {agent_type}^^xsd:string . 
source		SELECT * FROM dwcowl.main.agent

mappingId	agent_agent_role
target		:agent-agent-role/{agent_fk}/{related_agent_fk} a dwc:AgentAgentRole ; dc:source {agent_role_source}^^xsd:string ; dwc:agentID {agent_fk}^^xsd:string , {related_agent_fk}^^xsd:string ; dwc:agentRoleOrder {agent_role_order}^^xsd:integer ; dwc:relationshipEstablishedDate {agent_role_date}^^xsd:string ; dwc:relationshipOfResource {agent_role}^^xsd:string ; dwc:relationshipOfResourceID {agent_role_iri}^^xsd:string ; dwcdp:roleFor :agent/{related_agent_fk} ; dwcdp:roleHolder :agent/{agent_fk} . 
source		SELECT * FROM dwcowl.main.agent_agent_role

mappingId	agent_identifier
target		<{identifier}> a adms:Identifier ; dc:language {identifier_language}^^xsd:string ; dc:source {identifier_type_source}^^xsd:string ; dc:type {identifier_type}^^xsd:string ; dcterms:type <{identifier_type_iri}> ; dwc:agentID {agent_fk}^^xsd:string ; dwcdp:identifierFor :agent/{agent_fk} . 
source		SELECT * FROM dwcowl.main.agent_identifier

mappingId	agent_media
target		:agent-media/{media_fk}/{agent_fk} a dwc:AgentMedia ; ac:CVtermLiteral {subject_category}^^xsd:string ; ac:physicalSetting {physical_setting}^^xsd:string ; ac:subjectCategoryVocabulary <{subject_category_vocabulary}> ; ac:subjectOrientationLiteral {subject_orientation_literal}^^xsd:string ; ac:subjectOrientation <{subject_orientation}> ; ac:subjectPartLiteral {subject_part_literal}^^xsd:string ; ac:subjectPart <{subject_part}> ; dcterms:identifier {media_fk}^^xsd:string ; dwc:agentID {agent_fk}^^xsd:string ; Iptc4xmpExt:CVterm <{subject_category_iri}> ; dwcdp:hasContent :agent/{agent_fk} ; dwcdp:thisMedia :media/{media_fk} . 
source		SELECT * FROM dwcowl.main.agent_media

mappingId	bibliographic_resource
target		:bibliographic-resource/{reference_pk} a dcterms:BibliographicResource ; bibo:edition {edition}^^xsd:string ; bibo:editor :agent/{editor_fk} ; bibo:issue {issue}^^xsd:string ; bibo:pages {pages}^^xsd:string ; bibo:status <{peer_review_status}> ; bibo:volume {volume}^^xsd:string ; dc:creator {author}^^xsd:string ; dc:publisher {publisher}^^xsd:string ; dcterms:bibliographicCitation {bibliographic_citation}^^xsd:string ; dcterms:issued {issued}^^xsd:string ; dwc:agentID {author_fk}^^xsd:string , {editor_fk}^^xsd:string , {publisher_fk}^^xsd:string ; dwc:bibliographicIdentifier {bibliographic_identifier}^^xsd:string ; dwc:bibliographicIdentifierType {bibliographic_identifier_type}^^xsd:string ; dwc:editor {editor_id}^^xsd:string ; dwc:referenceID {reference_id}^^xsd:string , {reference_pk}^^xsd:string , {is_part_of_reference_fk}^^xsd:string , {is_part_of_reference_id}^^xsd:string ; dwc:referenceRemarks {reference_remarks}^^xsd:string ; dwc:referenceType {reference_type}^^xsd:string ; pav:sourceAccessedOn {accessed}^^xsd:string ; pav:version {version}^^xsd:string ; dwcdp:authoredBy :agent/{author_fk} ; dwcdp:editedBy :agent/{editor_fk} ; dwcdp:partOf :bibliographic-resource/{is_part_of_reference_fk} ; dwcdp:publishedBy :agent/{publisher_fk} . 
source		SELECT * FROM dwcowl.main.bibliographic_resource

mappingId	chronometric_age
target		:chronometric-age/{chronometric_age_pk} a chrono:ChronometricAge ; chrono:chronometricAgeConversionProtocol {chronometric_age_conversion_protocol}^^xsd:string ; chrono:chronometricAgeDeterminedBy {chronometric_age_determined_by}^^xsd:string ; chrono:chronometricAgeDeterminedDate {chronometric_age_determined_date}^^xsd:string ; chrono:chronometricAgeID {chronometric_age_id}^^xsd:string , {chronometric_age_pk}^^xsd:string ; chrono:chronometricAgeProtocol {chronometric_age_protocol}^^xsd:string ; chrono:chronometricAgeReferences {chronometric_age_references}^^xsd:string ; chrono:chronometricAgeRemarks {chronometric_age_remarks}^^xsd:string ; chrono:chronometricAgeUncertaintyInYears {chronometric_age_uncertainty_in_years}^^xsd:integer ; chrono:chronometricAgeUncertaintyMethod {chronometric_age_uncertainty_method}^^xsd:string ; chrono:earliestChronometricAge {earliest_chronometric_age}^^xsd:string ; chrono:earliestChronometricAgeReferenceSystem {earliest_chronometric_age_reference_system}^^xsd:string ; chrono:latestChronometricAge {latest_chronometric_age}^^xsd:string ; chrono:latestChronometricAgeReferenceSystem {latest_chronometric_age_reference_system}^^xsd:string ; chrono:materialDated {material_dated}^^xsd:string ; chrono:materialDatedID {material_dated_fk}^^xsd:string , {material_dated_id}^^xsd:string ; chrono:materialDatedRelationship {material_dated_relationship}^^xsd:string ; chrono:uncalibratedChronometricAge {uncalibrated_chronometric_age}^^xsd:string ; chrono:verbatimChronometricAge {verbatim_chronometric_age}^^xsd:string ; dwc:chronometricAgeDeterminedByID {chronometric_age_determined_by_id}^^xsd:string ; dwc:agentID {chronometric_age_determined_by_fk}^^xsd:string , {chronometric_age_determined_by_id}^^xsd:string ; dwc:eventID {event_fk}^^xsd:string ; dwc:protocolID {chronometric_age_conversion_protocol_fk}^^xsd:string , {chronometric_age_protocol_fk}^^xsd:string ; dwcdp:ageFor :event/{event_fk} ; dwcdp:dated :material-entity/{material_dated_fk} ; dwcdp:determinedBy :agent/{chronometric_age_determined_by_fk} ; dwcdp:followed :protocol/{chronometric_age_protocol_fk} , :protocol/{chronometric_age_conversion_protocol_fk} . 
