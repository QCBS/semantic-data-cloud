mappingId	chronometric_age_media
target		:chronometric-age-media/{media_fk}/{chronometric_age_fk} a dwc:ChronometricAgeMedia ; ac:CVtermLiteral {subject_category}^^xsd:string ; ac:physicalSetting {physical_setting}^^xsd:string ; ac:subjectCategoryVocabulary <{subject_category_vocabulary}> ; ac:subjectOrientationLiteral {subject_orientation_literal}^^xsd:string ; ac:subjectOrientation <{subject_orientation}> ; ac:subjectPartLiteral {subject_part_literal}^^xsd:string ; ac:subjectPart <{subject_part}> ; chrono:chronometricAgeID {chronometric_age_fk}^^xsd:string ; dcterms:identifier {media_fk}^^xsd:string ; Iptc4xmpExt:CVterm <{subject_category_iri}> ; dwcdp:hasContent :chronometric-age/{chronometric_age_fk} ; dwcdp:thisMedia :media/{media_fk} . 
source		SELECT * FROM dwcowl.main.chronometric_age_media

mappingId	chronometric_age_protocol
target		:chronometric-age/{chronometric_age_fk} dwcdp:followed :protocol/{protocol_fk} . :protocol/{protocol_fk} dwcdp:usedFor :chronometric-age/{chronometric_age_fk} . 
source		SELECT * FROM dwcowl.main.chronometric_age_protocol

mappingId	chronometric_age_reference
target		:chronometric-age-reference/{reference_fk}/{chronometric_age_fk} a dwc:ChronometricAgeReference ; chrono:chronometricAgeID {chronometric_age_fk}^^xsd:string ; dwc:referenceID {reference_fk}^^xsd:string ; dwc:relationshipOfResource {relationship_type}^^xsd:string ; dwcdp:mentioned :chronometric-age/{chronometric_age_fk} ; dwcdp:mentionedIn :bibliographic-resource/{reference_fk} . 
