mappingId	chronometric_age_assertion
target		:assertion/{assertion_pk} a dwc:Assertion ; chrono:chronometricAgeID {chronometric_age_fk}^^xsd:string ; dc:source {assertion_type_source}^^xsd:string , {assertion_value_source}^^xsd:string , {assertion_unit_source}^^xsd:string ; dwc:assertionBy {assertion_by}^^xsd:string ; dwc:agentID {assertion_by_fk}^^xsd:string , {assertion_by_id}^^xsd:string ; dwc:assertionEffectiveDate {assertion_effective_date}^^xsd:string ; dwc:assertionError {assertion_error}^^xsd:string ; dwc:assertionID {assertion_id}^^xsd:string ; dwc:assertionMadeDate {assertion_made_date}^^xsd:string ; dwc:assertionProtocols {assertion_protocols}^^xsd:string ; dwc:assertionReferences {assertion_references}^^xsd:string ; dwc:assertionRemarks {assertion_remarks}^^xsd:string ; dwc:assertionType {assertion_type}^^xsd:string ; dwc:assertionUnit {assertion_unit}^^xsd:string ; dwc:assertionValue {assertion_value}^^xsd:string ; dwc:protocolID {assertion_protocol_fk} ; dwc:verbatimAssertionType {verbatim_assertion_type}^^xsd:string ; dwciri:assertionUnit <{assertion_unit_iri}> ; dwciri:measurementType <{assertion_type_iri}> ; dwciri:measurementValue <{assertion_value_iri}> ; dwcdp:about :chronometric-age/{chronometric_age_fk} ; dwcdp:assertedBy :agent/{assertion_by_fk} ; dwcdp:followed :protocol/{assertion_protocol_fk} . 
