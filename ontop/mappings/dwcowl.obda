mappingId	event
target		:event/{event_pk} a dwc:Event ; dcterms:title {preferred_event_name}^^xsd:string ; dwc:agentID {georeferenced_by_fk}^^xsd:string , {georeferenced_by_id}^^xsd:string ; dwc:associatedReferences {event_references}^^xsd:string ; dwc:continent {continent}^^xsd:string ; dwc:coordinatePrecision {coordinate_precision}^^xsd:decimal ; dwc:coordinateUncertaintyInMeters {coordinate_uncertainty_in_meters}^^xsd:decimal ; dwc:country {country}^^xsd:string ; dwc:countryCode {country_code}^^xsd:string ; dwc:county {county}^^xsd:string ; dwc:dataGeneralizations {data_generalizations}^^xsd:string ; dwc:datasetID {dataset_id}^^xsd:string ; dwc:datasetName {dataset_name}^^xsd:string ; dwc:day {day}^^xsd:integer ; dwc:decimalLatitude {decimal_latitude}^^xsd:decimal ; dwc:decimalLongitude {decimal_longitude}^^xsd:decimal ; dwc:endDayOfYear {end_day_of_year}^^xsd:integer ; dwc:eventCategory {event_category}^^xsd:string ; dwc:eventDate {event_date}^^xsd:string ; dwc:eventID {event_id}^^xsd:string , {event_pk}^^xsd:string , {parent_event_fk}^^xsd:string ; dwc:eventRemarks {event_remarks}^^xsd:string ; dwc:eventTime {event_time}^^xsd:string ; dwc:eventType {event_type}^^xsd:string ; dwc:feedbackURL {feedback_url} ; dwc:fieldNotes {field_notes}^^xsd:string ; dwc:fieldNumber {field_number}^^xsd:string ; dwc:footprintSpatialFit {footprint_spatial_fit}^^xsd:decimals ; dwc:footprintSRS {footprint_srs}^^xsd:string ; dwc:footprintWKT {footprint_wkt}^^xsd:string ; dwc:geodeticDatum {geodetic_datum}^^xsd:string ; dwc:geologicalContextID {geological_context_fk}^^xsd:string , {geological_context_id}^^xsd:string ; dwc:georeferenceProtocol {georeference_protocol}^^xsd:string ; dwc:georeferenceRemarks {georeference_remarks}^^xsd:string ; dwc:georeferenceSources {georeference_sources}^^xsd:string ; dwc:georeferenceVerificationStatus {georeference_verification_status}^^xsd:string ; dwc:georeferencedBy {georeferenced_by}^^xsd:string ; dwc:georeferencedDate {georeferenced_date}^^xsd:string ; dwc:habitat {habitat}^^xsd:string ; dwc:higherGeography {higher_geography}^^xsd:string ; dwc:higherGeographyID {higher_geography_id}^^xsd:string ; dwc:informationWithheld {information_withheld}^^xsd:string ; dwc:island {island}^^xsd:string ; dwc:islandGroup {island_group}^^xsd:string ; dwc:locality {locality}^^xsd:string ; dwc:locationAccordingTo {location_according_to}^^xsd:string ; dwc:locationID {location_id}^^xsd:string ; dwc:locationRemarks {location_remarks}^^xsd:string ; dwc:maximumDepthInMeters {maximum_depth_in_meters}^^xsd:decimal ; dwc:maximumDistanceAboveSurfaceInMeters {maximum_distance_above_surface_in_meters}^^xsd:decimal ; dwc:maximumElevationInMeters {maximum_elevation_in_meters}^^xsd:decimal ; dwc:minimumDepthInMeters {minimum_depth_in_meters}^^xsd:decimal ; dwc:minimumDistanceAboveSurfaceInMeters {minimum_distance_above_surface_in_meters}^^xsd:string ; dwc:minimumElevationInMeters {minimum_elevation_in_meters}^^xsd:decimal ; dwc:month {month}^^xsd:integer ; dwc:municipality {municipality}^^xsd:string ; dwc:namedPlace {named_place}^^xsd:string ; dwc:pointRadiusSpatialFit {point_radius_spatial_fit}^^xsd:decimal ; dwc:preferredSpatialRepresentation {preferred_spatial_representation}^^xsd:string ; dwc:protocolID {georeference_protocol_fk}^^xsd:string ; dwc:recordedBy {recorded_by}^^xsd:string ; dwc:recordedByID {recorded_by_id}^^xsd:string , {recorded_by_fk}^^xsd:string ; dwc:sampledSubstrateCategory {sampled_substrate_category}^^xsd:string ; dwc:sampledSubstrateLayer {sampled_substrate_layer}^^xsd:string ; dwc:siteNumber {site_number}^^xsd:string ; dwc:startDayOfYear {start_day_of_year}^^xsd:integer ; dwc:stateProvince {state_province}^^xsd:string ; dwc:verbatimCoordinateSystem {verbatim_coordinate_system}^^xsd:string ; dwc:verbatimCoordinates {verbatim_coordinates}^^xsd:string ; dwc:verbatimDepth {verbatim_depth}^^xsd:string ; dwc:verbatimElevation {verbatim_elevation}^^xsd:string ; dwc:verbatimEventDate {verbatim_event_date}^^xsd:string ; dwc:verbatimLatitude {verbatim_latitude}^^xsd:string ; dwc:verbatimLocality {verbatim_locality}^^xsd:string ; dwc:verbatimLongitude {verbatim_longitude}^^xsd:string ; dwc:verbatimSRS {verbatim_srs} ; dwc:verticalDatum {vertical_datum}^^xsd:string ; dwc:waterBody {water_body}^^xsd:string ; dwc:year {year}^^xsd:integer ; eco:eventDurationUnit {event_duration_unit}^^xsd:string ; eco:eventDurationValue {event_duration_value}^^xsd:decimal ; eco:isVegetationCoverReported {is_vegetation_cover_reported}^^xsd:boolean ; eco:reportedExtremeConditions {reported_extreme_conditions}^^xsd:string ; eco:reportedWeather {reported_weather}^^xsd:string ; dwcdp:followed :protocol/{event_protocol_fk} , :protocol/{georeference_protocol_fk} ; dwcdp:happenedDuring :event/{parent_event_fk} ; dwcdp:georeferencedBy :agent/{georeferenced_by_fk} ; dwcdp:hasProvenance :provenance/{provenance_fk} ; dwcdp:recordedBy :agent/{recorded_by_fk} ; dwcdp:spatialLocation :location/{location_id} ; dwcdp:withinContext :geological-context/{geological_context_fk} . 
