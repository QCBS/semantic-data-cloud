mappingId	chronometric_age_agent_role
target		:chronometric-age-agent-role/{agent_fk}/{chronometric_age_fk} a dwc:ChronometricAgeAgentRole ; chrono:chronometricAgeID {chronometric_age_fk}^^xsd:string ; dc:source {agent_role_source}^^xsd:string ; dwc:agentID {agent_fk}^^xsd:string ; dwc:agentRoleOrder {agent_role_order}^^xsd:integer ; dwc:relationshipEstablishedDate {agent_role_date}^^xsd:string ; dwc:relationshipOfResource {agent_role}^^xsd:string ; dwc:relationshipOfResourceID {agent_role_iri}^^xsd:string ; dwcdp:roleFor :chronometric-age/{chronometric_age_fk} ; dwcdp:roleHolder :agent/{agent_fk} . 
